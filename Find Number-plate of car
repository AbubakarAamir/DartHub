class Car {
  String name;
  String numberPlate;
  int year;
  String color;
  int price;
  
  Car({required this.name, required this.numberPlate, required this.year, required this.color, required this.price});
}

void main() {
  List<Car> cars = [
    Car(name: "Prius", numberPlate: "ABC-123", year: 2022, color: "Black", price: 3500000),
    Car(name: "Civic", numberPlate: "XYZ-789", year: 2020, color: "White", price: 4200000),
    Car(name: "Corolla", numberPlate: "LEH-456", year: 2022, color: "Silver", price: 3800000),
    Car(name: "Mehran", numberPlate: "KHI-111", year: 2018, color: "Blue", price: 1800000),
  ];
  
  String searchPlate = "2022"; // Number plate search karo
  
  print("Searching for number plate containing: $searchPlate");
  print("===== RESULTS =====");
  
  for (var car in cars) {
    if (car.numberPlate.contains(searchPlate)) {
      print("✅ Found: ${car.name} - ${car.numberPlate} - ${car.year} - ${car.color} - Rs.${car.price}");
    }
  }
}


